{
  "manifest_version": 3,
  "name": "AMEVA Universal CORS Unblocker",
  "version": "1.0.0",
  "description": "Cross-browser CORS Unblocker for AMEVA Web Downloader (Chrome, Edge, Whale, Opera, Firefox)",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cors_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cors-unblocker@ameva.downloader",
      "strict_min_version": "109.0"
    }
  }
}
